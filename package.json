{
  "name": "com.blackblazent.mieyakourah",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:blackmusic": "pnpm --filter @blackblazent/blackmusic build",
    "build:all": "pnpm build && pnpm build:blackmusic && pnpm build:vineward",
    "dev:blackmusic": "pnpm --filter @blackblazent/blackmusic dev",
    "build:vineward": "pnpm --filter @blackblazent/vineward build",
    "dev:vineward": "pnpm --filter @blackblazent/vineward dev",
    "banners": "python3 tools/banners/generate.py"
  },
  "dependencies": {
    "framer-motion": "^12.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "@blackblazent/core": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.3.1"
  }
}